<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "La Canopée Fleurie — Artisan Floral" }}</title>
<meta name="description" content="{{ description or 'La Canopée Fleurie, artisan floral en Vaucluse. Compositions pour mariage, deuil, événements et bouquets de saison.' }}">
<meta property="og:title" content="{{ title or 'La Canopée Fleurie — Artisan Floral' }}">
<meta property="og:description" content="Compositions florales artisanales : mariage, deuil, événements, bouquets de saison.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Marck+Script&family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
</head>
<body>

<header>
  <nav class="nav">
    <a href="/" class="brand-logo">
      <img src="/images/logo.png" alt="La Canopée Fleurie" onerror="this.style.display='none'">
      <span class="brand">La Canopée Fleurie<small>Artisan Floral</small></span>
    </a>
    <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
    <div class="menu" id="menu">
      <a href="/#collections">Créations</a>
      <a href="/#cours">Cours</a>
      <a href="/#apropos">L'atelier</a>
      <a href="/#valeurs">Savoir-faire</a>
      <a href="/#avis">Avis</a>
      <a href="/#contact" class="cta">Contact</a>
    </div>
  </nav>
</header>

{{ content | safe }}

<footer>
  <div class="wrap">
    <div class="foot-brand-logo">
      <img src="/images/logo.png" alt="La Canopée Fleurie" onerror="this.style.display='none'">
      <div class="brand" style="font-family:var(--script);font-size:1.8rem">La Canopée Fleurie<small style="display:block;font-family:var(--sans);font-size:.55rem;letter-spacing:.35em;text-transform:uppercase;margin-top:4px">Artisan Floral</small></div>
    </div>
    <div class="foot-links">
      <a href="/#collections">Créations</a>
      <a href="/#apropos">L'atelier</a>
      <a href="/#valeurs">Savoir-faire</a>
      <a href="/#contact">Contact</a>
    </div>
    <div class="foot-social">
      <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">◎</a>
      <a href="#" aria-label="Facebook">f</a>
    </div>
    <div class="copy">© <span id="year"></span> La Canopée Fleurie — Artisan Floral · Vaucluse · Tous droits réservés</div>
  </div>
</footer>

<script>
const burger=document.getElementById('burger'),menu=document.getElementById('menu');
if(burger){burger.addEventListener('click',()=>{burger.classList.toggle('open');menu.classList.toggle('open')});
menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{burger.classList.remove('open');menu.classList.remove('open')}));}
const io=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
const y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();
</script>
</body>
</html>
