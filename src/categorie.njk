---
layout: base.njk
pagination:
  data: collections.categoriesVisibles
  size: 1
  alias: cat
permalink: "/{{ cat.data.slug }}/"
eleventyComputed:
  title: "{{ cat.data.titre }} — La Canopée Fleurie"
  description: "{{ cat.data.description }}"
---

<section class="cat-hero">
  <div class="wrap inner">
    <a href="/#collections" class="back" data-en="← All creations">← Toutes les créations</a>
    <p class="eyebrow" data-en="Our creations">Nos créations</p>
    <h1>{{ cat.data.titre }}</h1>
    <div class="price">{{ cat.data.prix }}</div>
    {% if cat.data.intro %}<p class="cat-intro">{{ cat.data.intro }}</p>{% endif %}
    <div class="cat-hero-actions">
      <a href="/#contact" class="btn btn-primary" data-en="Request a quote">Demander un devis</a>
      <a href="/#collections" class="btn btn-ghost" data-en="See other creations">Voir les autres créations</a>
    </div>
  </div>
</section>

<section class="gallery">
  <div class="wrap">
    <div class="gallery-grid" id="gallery">
      {% if cat.data.galerie %}
        {% for photo in cat.data.galerie %}
        <div class="item" data-full="{{ photo.image }}">
          <img src="{{ photo.image }}" alt="{{ photo.legende }}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1487070183336-b863922373d4?w=600&q=80'">
          {% if photo.legende %}<div class="cap">{{ photo.legende }}</div>{% endif %}
        </div>
        {% endfor %}
      {% else %}
        <p style="color:var(--vert-jardin)" data-en="Photos for this category are coming soon.">Les photos de cette catégorie arrivent bientôt.</p>
      {% endif %}
    </div>
  </div>
</section>

<section class="cat-cta">
  <div class="wrap">
    <h2 data-en-html="Looking for a <em>{{ cat.data.titre | lower }}</em> creation?">Envie d'une création <em>{{ cat.data.titre | lower }}</em> ?</h2>
    <p data-en="Contact us to design together a creation that reflects you.">Contactez-nous pour composer ensemble une création qui vous ressemble.</p>
    <a href="/#contact" class="btn btn-primary" data-en="Get in touch">Prendre contact</a>
  </div>
</section>

<div class="lightbox" id="lightbox">
  <button class="lb-close" id="lbClose" aria-label="Fermer">×</button>
  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Précédent">‹</button>
  <img id="lbImg" src="" alt="">
  <button class="lb-nav lb-next" id="lbNext" aria-label="Suivant">›</button>
</div>

<script>
(function(){
  const items=[...document.querySelectorAll('#gallery .item')];
  const lb=document.getElementById('lightbox'),lbImg=document.getElementById('lbImg');
  let idx=0;
  function show(i){idx=(i+items.length)%items.length;lbImg.src=items[idx].dataset.full;lb.classList.add('open')}
  items.forEach((it,i)=>it.addEventListener('click',()=>show(i)));
  document.getElementById('lbClose').onclick=()=>lb.classList.remove('open');
  document.getElementById('lbPrev').onclick=e=>{e.stopPropagation();show(idx-1)};
  document.getElementById('lbNext').onclick=e=>{e.stopPropagation();show(idx+1)};
  lb.addEventListener('click',e=>{if(e.target===lb)lb.classList.remove('open')});
  document.addEventListener('keydown',e=>{
    if(!lb.classList.contains('open'))return;
    if(e.key==='Escape')lb.classList.remove('open');
    if(e.key==='ArrowLeft')show(idx-1);
    if(e.key==='ArrowRight')show(idx+1);
  });
})();
</script>
